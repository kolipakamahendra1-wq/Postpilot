# Copy to .env. Everything has a safe default for a local demo.

# API access. Change both before exposing the server.
POSTPILOT_TOKEN=pp-demo-token
POSTPILOT_SECRET_KEY=change-me-to-a-long-random-string

# Model: ollama | openai (any OpenAI-compatible server) | none (template drafter)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# mock never touches a real account. live posts through connected X or LinkedIn accounts.
PUBLISHER=mock

# Brand rules
BANNED_WORDS=guaranteed,100% free,click here,act now
TRENDING_FEED=https://hnrss.org/frontpage

# Slack approvals (optional)
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# OAuth apps (optional). Redirect URI is PUBLIC_URL/api/oauth/{provider}/callback
PUBLIC_URL=http://localhost:8050
FRONTEND_URL=http://localhost:5190
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
